rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function activeUser() {
      return signedIn()
        && exists(userPath())
        && get(userPath()).data.ativo == true
        && get(userPath()).data.email == request.auth.token.email;
    }
    function roleIs(role) {
      return activeUser() && get(userPath()).data.perfil == role;
    }
    function admin() { return roleIs('admin'); }
    function pastor() { return roleIs('pastor') || admin(); }
    function secretaria() { return roleIs('secretaria'); }
    function lider() { return roleIs('lider'); }
    function voluntario() { return roleIs('voluntario'); }
    function staffRead() { return admin() || secretaria() || lider() || pastor(); }
    function staffWrite() { return admin() || secretaria(); }
    function leaderOwnsTurma(turmaId) {
      return lider() && get(userPath()).data.turmaId == turmaId;
    }
    function validMark() {
      return request.resource.data.keys().hasOnly([
          'turmaId', 'posicaoOuPessoaId', 'presente', 'presenteEm',
          'batizado', 'batizadoEm', 'porUid', 'porNome'
        ])
        && request.resource.data.turmaId is string
        && request.resource.data.posicaoOuPessoaId is string
        && request.resource.data.keys().hasAny(['presente','batizado'])
        && (!('presente' in request.resource.data) || request.resource.data.presente is bool)
        && (!('batizado' in request.resource.data) || request.resource.data.batizado is bool)
        && (!('presenteEm' in request.resource.data) || request.resource.data.presenteEm is string || request.resource.data.presenteEm is timestamp)
        && (!('batizadoEm' in request.resource.data) || request.resource.data.batizadoEm is string || request.resource.data.batizadoEm is timestamp)
        && request.resource.data.porUid == request.auth.uid
        && request.resource.data.porNome is string
        && request.resource.data.porNome.size() <= 120
        && request.resource.data.turmaId.size() <= 64
        && request.resource.data.posicaoOuPessoaId.size() <= 128;
    }
    function validPersonRoot() {
      return request.resource.data.keys().hasOnly([
          'turmaId','nomeExibicao','nomeBusca','telefone','telefoneValido','telefoneRevisar',
          'responsavelInformado','idade','faixaEtaria','menor','jornada','aulas','aulao',
          'camiseta','pendencia','origem','pessoaCanonicaId','mergeFonteIds',
          'camposConflitantes','ordemNumero','pastor','batizado','batizadoEm',
          'revision','updatedAt','updatedBy','migrationVersion'
        ])
        && (!('nomeExibicao' in request.resource.data) || (request.resource.data.nomeExibicao is string && request.resource.data.nomeExibicao.size() <= 120))
        && (!('nomeBusca' in request.resource.data) || (request.resource.data.nomeBusca is string && request.resource.data.nomeBusca.size() <= 160))
        && (!('turmaId' in request.resource.data) || request.resource.data.turmaId == null || request.resource.data.turmaId is string)
        && (!('telefone' in request.resource.data) || request.resource.data.telefone == null || (request.resource.data.telefone is string && request.resource.data.telefone.size() <= 20))
        && (!('telefoneValido' in request.resource.data) || request.resource.data.telefoneValido == null || request.resource.data.telefoneValido is bool)
        && (!('telefoneRevisar' in request.resource.data) || request.resource.data.telefoneRevisar is bool)
        && (!('faixaEtaria' in request.resource.data) || (request.resource.data.faixaEtaria is string && request.resource.data.faixaEtaria.size() <= 24))
        && (!('pessoaCanonicaId' in request.resource.data) || request.resource.data.pessoaCanonicaId is string)
        && (!('mergeFonteIds' in request.resource.data) || (request.resource.data.mergeFonteIds is list && request.resource.data.mergeFonteIds.size() <= 100))
        && (!('camposConflitantes' in request.resource.data) || (request.resource.data.camposConflitantes is list && request.resource.data.camposConflitantes.size() <= 30))
        && (!('responsavelInformado' in request.resource.data) || request.resource.data.responsavelInformado == null || request.resource.data.responsavelInformado is bool)
        && (!('idade' in request.resource.data) || request.resource.data.idade == null || request.resource.data.idade is int)
        && (!('menor' in request.resource.data) || request.resource.data.menor == null || request.resource.data.menor is bool)
        && (!('revision' in request.resource.data) || request.resource.data.revision is int)
        && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy is string)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string || request.resource.data.updatedAt is timestamp)
        && (!('jornada' in request.resource.data) || (request.resource.data.jornada is map
          && request.resource.data.jornada.keys().hasOnly(['status','arquivadaRevisao'])
          && request.resource.data.jornada.status is string
          && request.resource.data.jornada.status.size() <= 40
          && (!('arquivadaRevisao' in request.resource.data.jornada) || request.resource.data.jornada.arquivadaRevisao is bool)))
        && (!('aulas' in request.resource.data) || (request.resource.data.aulas is map
          && request.resource.data.aulas.keys().hasOnly(['1','2','3','4'])
          && (!('1' in request.resource.data.aulas) || request.resource.data.aulas['1'] == null || request.resource.data.aulas['1'] is bool)
          && (!('2' in request.resource.data.aulas) || request.resource.data.aulas['2'] == null || request.resource.data.aulas['2'] is bool)
          && (!('3' in request.resource.data.aulas) || request.resource.data.aulas['3'] == null || request.resource.data.aulas['3'] is bool)
          && (!('4' in request.resource.data.aulas) || request.resource.data.aulas['4'] == null || request.resource.data.aulas['4'] is bool)))
        && (!('camiseta' in request.resource.data) || (request.resource.data.camiseta is map
          && request.resource.data.camiseta.keys().hasOnly(['opcao','tamanho','pago','valor','data','entregue','entregueEm','arquivadaRevisao'])
          && request.resource.data.camiseta.opcao in ['', 'quer', 'nao_quer', 'ja_tem']
          && (!('tamanho' in request.resource.data.camiseta) || request.resource.data.camiseta.tamanho == null || (request.resource.data.camiseta.tamanho is string && request.resource.data.camiseta.tamanho.size() <= 20))
          && (!('data' in request.resource.data.camiseta) || request.resource.data.camiseta.data == null || request.resource.data.camiseta.data is string)
          && (!('pago' in request.resource.data.camiseta) || request.resource.data.camiseta.pago == null || request.resource.data.camiseta.pago is bool)
          && (!('entregue' in request.resource.data.camiseta) || request.resource.data.camiseta.entregue == null || request.resource.data.camiseta.entregue is bool)
          && (!('entregueEm' in request.resource.data.camiseta) || request.resource.data.camiseta.entregueEm == null || request.resource.data.camiseta.entregueEm is string || request.resource.data.camiseta.entregueEm is timestamp)
          && (!('valor' in request.resource.data.camiseta) || request.resource.data.camiseta.valor == null || request.resource.data.camiseta.valor is number)))
        && (!('pendencia' in request.resource.data) || (request.resource.data.pendencia is map
          && request.resource.data.pendencia.keys().hasOnly(['texto','arquivadaRevisao','tipo'])
          && (!('texto' in request.resource.data.pendencia) || (request.resource.data.pendencia.texto is string && request.resource.data.pendencia.texto.size() <= 2000))
          && (!('tipo' in request.resource.data.pendencia) || (request.resource.data.pendencia.tipo is string && request.resource.data.pendencia.tipo.size() <= 60))
          && (!('arquivadaRevisao' in request.resource.data.pendencia) || request.resource.data.pendencia.arquivadaRevisao is bool)))
        && (!('aulao' in request.resource.data) || (request.resource.data.aulao is map
          && request.resource.data.aulao.keys().hasOnly(['inscrito','data','dataTexto'])
          && (!('inscrito' in request.resource.data.aulao) || request.resource.data.aulao.inscrito is bool)
          && (!('data' in request.resource.data.aulao) || request.resource.data.aulao.data == null || request.resource.data.aulao.data is string)
          && (!('dataTexto' in request.resource.data.aulao) || request.resource.data.aulao.dataTexto == null || (request.resource.data.aulao.dataTexto is string && request.resource.data.aulao.dataTexto.size() <= 40))))
        && (!('telefoneRevisar' in request.resource.data) || request.resource.data.telefoneRevisar is bool);
    }
    function validOrderRoot() {
      return request.resource.data.keys().hasOnly([
          'turmaId','posicao','nome','nomeBusca','pessoaId','origem','updatedAt','migrationVersion',
          'pastor','fichasRetiradas','fichaRetirada','presente','batizado','presenteEm','batizadoEm',
          'tipoVinculo','subgrupo','prioridades','resumoPessoa','revision','updatedBy'
        ])
        && request.resource.data.turmaId is string
        && request.resource.data.turmaId.size() <= 64
        && (!('posicao' in request.resource.data) || request.resource.data.posicao is int || request.resource.data.posicao is string)
        && (!('nome' in request.resource.data) || (request.resource.data.nome is string && request.resource.data.nome.size() <= 120))
        && (!('nomeBusca' in request.resource.data) || (request.resource.data.nomeBusca is string && request.resource.data.nomeBusca.size() <= 160))
        && (!('origem' in request.resource.data) || (
          request.resource.data.origem is map
          && request.resource.data.origem.keys().hasOnly(['aba','linha','versao'])
          && (!('aba' in request.resource.data.origem) || (request.resource.data.origem.aba is string && request.resource.data.origem.aba.size() <= 60))
          && (!('linha' in request.resource.data.origem) || request.resource.data.origem.linha is int)
          && (!('versao' in request.resource.data.origem) || (request.resource.data.origem.versao is string && request.resource.data.origem.versao.size() <= 120))))
        && (!('pessoaId' in request.resource.data) || request.resource.data.pessoaId == null || (request.resource.data.pessoaId is string && request.resource.data.pessoaId.size() <= 150))
        && (!('pessoaId' in request.resource.data) || request.resource.data.pessoaId == null || !('tipoVinculo' in request.resource.data) || request.resource.data.tipoVinculo == 'pessoa')
        && (!('tipoVinculo' in request.resource.data) || request.resource.data.tipoVinculo != 'externo' || ((!('pessoaId' in request.resource.data) || request.resource.data.pessoaId == null) && ('nome' in request.resource.data) && request.resource.data.nome is string && request.resource.data.nome.size() > 0))
        && (!('tipoVinculo' in request.resource.data) || request.resource.data.tipoVinculo != 'pessoa' || (('pessoaId' in request.resource.data) && request.resource.data.pessoaId is string))
        && (!('tipoVinculo' in request.resource.data) || request.resource.data.tipoVinculo in ['vazio','pessoa','externo','nao_vinculado'])
        && (!('pastor' in request.resource.data) || request.resource.data.pastor == null || (request.resource.data.pastor is string && request.resource.data.pastor.size() <= 120))
        && (!('subgrupo' in request.resource.data) || request.resource.data.subgrupo in ['', 'kids', 'grupo_especial'])
        && (!('fichaRetirada' in request.resource.data) || request.resource.data.fichaRetirada is bool)
        && (!('fichasRetiradas' in request.resource.data) || request.resource.data.fichasRetiradas is bool)
        && (!('presente' in request.resource.data) || request.resource.data.presente is bool)
        && (!('batizado' in request.resource.data) || request.resource.data.batizado is bool)
        && (!('presenteEm' in request.resource.data) || request.resource.data.presenteEm == null || request.resource.data.presenteEm is string || request.resource.data.presenteEm is timestamp)
        && (!('batizadoEm' in request.resource.data) || request.resource.data.batizadoEm == null || request.resource.data.batizadoEm is string || request.resource.data.batizadoEm is timestamp)
        && (!('prioridades' in request.resource.data) || (request.resource.data.prioridades is list
          && request.resource.data.prioridades.size() <= 3
          && request.resource.data.prioridades.toSet().hasOnly(['gestante','idoso','necessidade_especial'])))
        && (!('resumoPessoa' in request.resource.data) || request.resource.data.resumoPessoa == null || (
          request.resource.data.resumoPessoa is map
          && request.resource.data.resumoPessoa.keys().hasOnly(['menor','responsavelInformado','camiseta','pendencia'])
          && (!('menor' in request.resource.data.resumoPessoa) || request.resource.data.resumoPessoa.menor is bool)
          && (!('responsavelInformado' in request.resource.data.resumoPessoa) || request.resource.data.resumoPessoa.responsavelInformado is bool)
          && (!('camiseta' in request.resource.data.resumoPessoa) || (request.resource.data.resumoPessoa.camiseta is map
            && request.resource.data.resumoPessoa.camiseta.keys().hasOnly(['opcao','tamanho'])
            && request.resource.data.resumoPessoa.camiseta.opcao in ['', 'quer', 'nao_quer', 'ja_tem']
            && (!('tamanho' in request.resource.data.resumoPessoa.camiseta) || request.resource.data.resumoPessoa.camiseta.tamanho == null || (request.resource.data.resumoPessoa.camiseta.tamanho is string && request.resource.data.resumoPessoa.camiseta.tamanho.size() <= 20))))
          && (!('pendencia' in request.resource.data.resumoPessoa) || (request.resource.data.resumoPessoa.pendencia is map
            && request.resource.data.resumoPessoa.pendencia.keys().hasOnly(['aberta','impeditiva'])
            && request.resource.data.resumoPessoa.pendencia.aberta is bool
            && request.resource.data.resumoPessoa.pendencia.impeditiva is bool))))
        && (!('revision' in request.resource.data) || (request.resource.data.revision is int && request.resource.data.revision >= 0))
        && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string || request.resource.data.updatedAt is timestamp);
    }
    function classPath(turmaId) {
      return /databases/$(database)/documents/turmas/$(turmaId);
    }
    function orderStatePath(turmaId) {
      return /databases/$(database)/documents/ordemTurma/$(turmaId);
    }
    function orderCanRead(turmaId) {
      return staffRead()
        || (exists(classPath(turmaId))
          && voluntario()
          && get(classPath(turmaId)).data.status == 'ativa');
    }
    function orderCanEdit(turmaId) {
      return (staffWrite() || leaderOwnsTurma(turmaId))
        && exists(classPath(turmaId))
        && get(classPath(turmaId)).data.status != 'encerrada'
        && (!exists(orderStatePath(turmaId)) || get(orderStatePath(turmaId)).data.frozen != true);
    }
    function personClassOpen(turmaId) {
      return !(turmaId is string)
        || (exists(classPath(turmaId))
          && get(classPath(turmaId)).data.status != 'encerrada'
          && (!exists(orderStatePath(turmaId)) || get(orderStatePath(turmaId)).data.closing != true));
    }
    // Durante o encerramento, a secretaria só pode arquivar pendências já abertas.
    function archivePersonDuringClose(turmaId) {
      return staffWrite()
        && turmaId is string
        && exists(classPath(turmaId))
        && get(classPath(turmaId)).data.status != 'encerrada'
        && exists(orderStatePath(turmaId))
        && get(orderStatePath(turmaId)).data.closing == true
        && ('pendencia' in request.resource.data)
        && request.resource.data.pendencia is map
        && request.resource.data.pendencia.arquivadaRevisao == true
        && (!('pendencia' in resource.data) || resource.data.pendencia.arquivadaRevisao != true)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pendencia','revision','updatedAt','updatedBy'
        ]);
    }
    function validOrderMeta(turmaId) {
      return request.resource.data.keys().hasOnly(['turmaId','revision','frozen','closing','updatedAt','updatedBy'])
        && request.resource.data.turmaId == turmaId
        && request.resource.data.revision is int
        && request.resource.data.revision >= 0
        && request.resource.data.frozen is bool
        && (!('closing' in request.resource.data) || request.resource.data.closing is bool)
        && request.resource.data.updatedBy == request.auth.uid
        && (request.resource.data.updatedAt is string || request.resource.data.updatedAt is timestamp);
    }
    function validTurma() {
      return request.resource.data.keys().hasOnly([
          'numero','dataBatismo','local','status','capacidade','quantidadeNaPlanilha',
          'camposAConfirmar','migrationVersion','updatedAt','revision','updatedBy'
        ])
        && request.resource.data.numero is int
        && request.resource.data.status in ['planejada','ativa','encerrada']
        && (!('dataBatismo' in request.resource.data) || request.resource.data.dataBatismo == null || request.resource.data.dataBatismo is string || request.resource.data.dataBatismo is timestamp)
        && (!('local' in request.resource.data) || request.resource.data.local == null || (request.resource.data.local is string && request.resource.data.local.size() <= 160))
        && (!('capacidade' in request.resource.data) || request.resource.data.capacidade == null || (request.resource.data.capacidade is int && request.resource.data.capacidade >= 0))
        && (!('revision' in request.resource.data) || request.resource.data.revision is int)
        && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string || request.resource.data.updatedAt is timestamp);
    }
    function validOrderAudit() {
      return request.resource.data.acao in [
          'ordem_criada','ordem_atualizada','ordem_reordenada','ordem_resumos_atualizados',
          'turma_criada','turma_atualizada','turma_encerramento_iniciado','turma_encerrada'
        ]
        && request.resource.data.keys().hasOnly([
          'acao','documento','turmaId','posicaoId','uid','porNome','quando','alteracoes'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.documento is string
        && request.resource.data.documento.size() <= 512
        && request.resource.data.turmaId is string
        && request.resource.data.porNome is string
        && request.resource.data.porNome.size() <= 120
        && request.resource.data.quando is string
        && request.resource.data.alteracoes is list
        && request.resource.data.alteracoes.size() <= 450
        && (staffWrite() || leaderOwnsTurma(request.resource.data.turmaId));
    }
    function validBaptismRecord() {
      return request.resource.data.keys().hasOnly([
          'turmaId','ordemId','posicao','pessoaId','nome','pastor','dataBatismo',
          'confirmado','confirmadoEm','confirmadoPorUid','confirmadoPorNome','criadoEm'
        ])
        && request.resource.data.turmaId is string
        && request.resource.data.ordemId is string
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 120
        && request.resource.data.pastor is string
        && request.resource.data.confirmado == true
        && request.resource.data.confirmadoPorUid is string
        && request.resource.data.confirmadoPorNome is string
        && request.resource.data.confirmadoPorNome.size() <= 120
        && request.resource.data.dataBatismo is string;
    }
    function validContact() {
      return request.resource.data.keys().hasOnly(['telefone','responsavelNome','responsavelTelefone','updatedAt','updatedBy'])
        && (!('telefone' in request.resource.data) || request.resource.data.telefone == null || request.resource.data.telefone is string)
        && (!('responsavelNome' in request.resource.data) || request.resource.data.responsavelNome == null || (request.resource.data.responsavelNome is string && request.resource.data.responsavelNome.size() <= 120))
        && (!('responsavelTelefone' in request.resource.data) || request.resource.data.responsavelTelefone == null || (request.resource.data.responsavelTelefone is string && request.resource.data.responsavelTelefone.size() <= 20))
        && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid);
    }
    function validPrivateProfile() {
      return request.resource.data.keys().hasOnly(['verificacaoPerfil','observacoesRestritas','observacoes','updatedAt','updatedBy'])
        && (!('verificacaoPerfil' in request.resource.data) || request.resource.data.verificacaoPerfil == null || request.resource.data.verificacaoPerfil is string)
        && (!('observacoesRestritas' in request.resource.data) || request.resource.data.observacoesRestritas == null || (request.resource.data.observacoesRestritas is string && request.resource.data.observacoesRestritas.size() <= 3000))
        && (!('observacoes' in request.resource.data) || request.resource.data.observacoes == null || (request.resource.data.observacoes is string && request.resource.data.observacoes.size() <= 3000))
        && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid);
    }
    function validPrivateOrigin() {
      return request.resource.data.keys().hasOnly([
        'origem','idadeOriginal','dataOriginal','camposOriginais','updatedAt','migrationVersion'
      ]);
    }
    function linkedPersonAudit() {
      let personPath = /databases/$(database)/documents/pessoas/$(request.resource.data.pessoaId);
      let current = get(personPath);
      let afterState = getAfter(personPath);
      return request.resource.data.pessoaId is string
        && request.resource.data.pessoaId.size() <= 150
        && request.resource.data.documento == 'pessoas/' + request.resource.data.pessoaId
        && request.resource.data.revision is int
        && existsAfter(personPath)
        && afterState.data.revision == request.resource.data.revision
        && ((!exists(personPath) && request.resource.data.revision == 1)
          || (exists(personPath)
            && request.resource.data.revision == (('revision' in current.data) ? current.data.revision + 1 : 1)));
    }
    function workflowCanRead(turmaId) {
      return staffRead() || leaderOwnsTurma(turmaId);
    }
    function workflowCanEdit(turmaId) {
      return staffWrite() || leaderOwnsTurma(turmaId);
    }
    function workflowClassOpen(turmaId) {
      return turmaId is string
        && exists(classPath(turmaId))
        && get(classPath(turmaId)).data.status != 'encerrada'
        && (!exists(orderStatePath(turmaId)) || get(orderStatePath(turmaId)).data.closing != true);
    }
    function pendingPersonPath(pessoaId) {
      return /databases/$(database)/documents/pessoas/$(pessoaId);
    }
    function validPending() {
      return request.resource.data.keys().hasOnly([
          'turmaId','pessoaId','tipo','responsavel','prazo','status','notas',
          'automatico','autoKey','autoClosed','arquivadaRevisao','resolvidaEm',
          'criadoEm','criadoPor','criadoPorNome','updatedAt','updatedBy','revision'
        ])
        && request.resource.data.keys().hasAll([
          'turmaId','pessoaId','tipo','responsavel','prazo','status','notas',
          'automatico','autoClosed','arquivadaRevisao','criadoEm','criadoPor',
          'criadoPorNome','updatedAt','updatedBy','revision'
        ])
        && request.resource.data.turmaId is string
        && request.resource.data.pessoaId is string
        && request.resource.data.tipo is string
        && request.resource.data.tipo.size() > 0
        && request.resource.data.tipo.size() <= 80
        && request.resource.data.responsavel is string
        && request.resource.data.responsavel.size() <= 120
        && request.resource.data.prazo is string
        && request.resource.data.prazo.size() <= 10
        && request.resource.data.status in ['aberta','em_contato','resolvida','arquivada']
        && request.resource.data.notas is string
        && request.resource.data.notas.size() <= 1500
        && request.resource.data.automatico is bool
        && (!('autoKey' in request.resource.data) || (request.resource.data.autoKey is string && request.resource.data.autoKey.size() <= 60))
        && (!request.resource.data.automatico || ('autoKey' in request.resource.data && request.resource.data.autoKey is string))
        && request.resource.data.autoClosed is bool
        && request.resource.data.arquivadaRevisao is bool
        && (!('resolvidaEm' in request.resource.data) || request.resource.data.resolvidaEm == null || request.resource.data.resolvidaEm is string || request.resource.data.resolvidaEm is timestamp)
        && request.resource.data.criadoEm is string
        && request.resource.data.criadoPor is string
        && request.resource.data.criadoPorNome is string
        && request.resource.data.criadoPorNome.size() <= 120
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && exists(pendingPersonPath(request.resource.data.pessoaId))
        && get(pendingPersonPath(request.resource.data.pessoaId)).data.turmaId == request.resource.data.turmaId;
    }
    function validAulao() {
      return request.resource.data.keys().hasOnly([
          'turmaId','data','hora','local','vagas','reporAulas','inscritosCount',
          'lastRegistrationPessoaId','status','revision','createdAt','createdBy','updatedAt','updatedBy'
        ])
        && request.resource.data.turmaId is string
        && request.resource.data.data is string
        && request.resource.data.data.size() == 10
        && request.resource.data.hora is string
        && request.resource.data.hora.size() <= 5
        && request.resource.data.local is string
        && request.resource.data.local.size() > 0
        && request.resource.data.local.size() <= 160
        && request.resource.data.vagas is int
        && request.resource.data.vagas > 0
        && request.resource.data.vagas <= 1000
        && request.resource.data.reporAulas is list
        && request.resource.data.reporAulas.size() >= 1
        && request.resource.data.reporAulas.size() <= 4
        && request.resource.data.reporAulas.toSet().hasOnly([1,2,3,4])
        && request.resource.data.reporAulas.toSet().size() == request.resource.data.reporAulas.size()
        && request.resource.data.inscritosCount is int
        && request.resource.data.inscritosCount >= 0
        && request.resource.data.inscritosCount <= request.resource.data.vagas
        && (!('lastRegistrationPessoaId' in request.resource.data) || request.resource.data.lastRegistrationPessoaId == null || (request.resource.data.lastRegistrationPessoaId is string && request.resource.data.lastRegistrationPessoaId.size() <= 150))
        && request.resource.data.status in ['agendado','realizado','cancelado']
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.createdAt is string
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function aulaoPath(aulaoId) {
      return /databases/$(database)/documents/auloes/$(aulaoId);
    }
    function registrationPath(aulaoId,pessoaId) {
      return /databases/$(database)/documents/auloes/$(aulaoId)/inscricoes/$(pessoaId);
    }
    function validRegistration() {
      return request.resource.data.keys().hasOnly([
          'turmaId','pessoaId','status','inscritoEm','inscritoPorUid','inscritoPorNome',
          'presenteEm','presentePorUid','presentePorNome','revision','updatedAt','updatedBy'
        ])
        && request.resource.data.turmaId is string
        && request.resource.data.pessoaId is string
        && request.resource.data.status in ['inscrito','presente','cancelada']
        && request.resource.data.inscritoEm is string
        && request.resource.data.inscritoPorUid is string
        && request.resource.data.inscritoPorNome is string
        && request.resource.data.inscritoPorNome.size() <= 120
        && (request.resource.data.presenteEm == null || request.resource.data.presenteEm is string || request.resource.data.presenteEm is timestamp)
        && (request.resource.data.presentePorUid == null || request.resource.data.presentePorUid is string)
        && (request.resource.data.presentePorNome == null || (request.resource.data.presentePorNome is string && request.resource.data.presentePorNome.size() <= 120))
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function aulasCompletas(aulas,lista) {
      return aulas is map
        && (!lista.toSet().hasAny([1]) || aulas['1'] == true)
        && (!lista.toSet().hasAny([2]) || aulas['2'] == true)
        && (!lista.toSet().hasAny([3]) || aulas['3'] == true)
        && (!lista.toSet().hasAny([4]) || aulas['4'] == true);
    }
    function validPayment() {
      return request.resource.data.keys().hasOnly([
          'turmaId','pessoaId','valor','data','forma','recebidoPor','recebidoPorUid',
          'criadoEm','criadoPor','criadoPorNome'
        ])
        && request.resource.data.turmaId is string
        && request.resource.data.pessoaId is string
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.valor <= 100000
        && request.resource.data.data is string
        && request.resource.data.data.size() == 10
        && request.resource.data.forma in ['pix','dinheiro','cartao']
        && request.resource.data.recebidoPor is string
        && request.resource.data.recebidoPor.size() > 0
        && request.resource.data.recebidoPor.size() <= 120
        && request.resource.data.recebidoPorUid == request.auth.uid
        && request.resource.data.criadoEm is string
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoPorNome is string
        && request.resource.data.criadoPorNome.size() <= 120;
    }
    function validWorkConfig() {
      return request.resource.data.keys().hasOnly([
          'valorCamiseta','tamanhosCamiseta','tiposPendencia','mensagemPendencia',
          'mensagemReposicao','mensagemCamiseta','revision','updatedAt','updatedBy'
        ])
        && request.resource.data.valorCamiseta is number
        && request.resource.data.valorCamiseta >= 0
        && request.resource.data.valorCamiseta <= 10000
        && request.resource.data.tamanhosCamiseta is list
        && request.resource.data.tamanhosCamiseta.size() <= 30
        && request.resource.data.tiposPendencia is list
        && request.resource.data.tiposPendencia.size() <= 30
        && request.resource.data.mensagemPendencia is string
        && request.resource.data.mensagemPendencia.size() <= 500
        && request.resource.data.mensagemReposicao is string
        && request.resource.data.mensagemReposicao.size() <= 500
        && request.resource.data.mensagemCamiseta is string
        && request.resource.data.mensagemCamiseta.size() <= 500
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function validWorkflowAudit() {
      return request.resource.data.acao is string
        && request.resource.data.acao.matches('workflow_[a-z_]+')
        && request.resource.data.keys().hasOnly([
          'acao','documento','turmaId','pessoaId','aulaoId','revision',
          'uid','porNome','quando','alteracoes'
        ])
        && request.resource.data.documento is string
        && request.resource.data.documento.size() <= 512
        && (request.resource.data.turmaId == null || (request.resource.data.turmaId is string && request.resource.data.turmaId.size() <= 64))
        && (request.resource.data.pessoaId == null || (request.resource.data.pessoaId is string && request.resource.data.pessoaId.size() <= 150))
        && (request.resource.data.aulaoId == null || (request.resource.data.aulaoId is string && request.resource.data.aulaoId.size() <= 150))
        && request.resource.data.revision is int
        && request.resource.data.revision >= 0
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.porNome is string
        && request.resource.data.porNome.size() <= 120
        && request.resource.data.quando is string
        && request.resource.data.alteracoes is list
        && request.resource.data.alteracoes.size() <= 20
        && (staffWrite() || pastor() || leaderOwnsTurma(request.resource.data.turmaId));
    }
    function validAudit() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.acao is string
        && request.resource.data.quando is string
        && (
          (request.resource.data.acao == 'migracao_estruturada'
            && admin()
            && request.resource.data.keys().hasOnly([
              'acao','uid','email','quando','migrationId','documentosCriados',
              'documentosIgnorados','origemVersionId','camposNovos','criadoEm'
            ])
            && request.resource.data.documentosCriados is list
            && request.resource.data.documentosCriados.size() <= 150
            && request.resource.data.documentosIgnorados is int
            && request.resource.data.camposNovos is list)
          ||
          validOrderAudit()
          ||
          validWorkflowAudit()
          ||
          (request.resource.data.keys().hasOnly([
            'acao','documento','pessoaId','revision','uid','porNome','quando','alteracoes',
            'migrationId','email','criadoEm'
          ])
            && request.resource.data.documento is string
            && request.resource.data.documento.size() <= 512
            && request.resource.data.alteracoes is list
            && request.resource.data.alteracoes.size() <= 100
            && (admin() || (
              request.resource.data.pessoaId is string
              && request.resource.data.pessoaId.size() <= 150
              && request.resource.data.revision is int
              && request.resource.data.porNome is string
              && request.resource.data.porNome.size() <= 120
              && linkedPersonAudit()))
        ));
    }

    // O primeiro admin deve ser cadastrado manualmente no Console do Firebase.
    // Usuários sem documento ativo e e-mail correspondente não passam nas demais regras.
    match /usuarios/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || admin());
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['email','perfil','ativo','turmaId','nome','criadoEm','atualizadoEm'])
        && request.resource.data.email is string
        && request.resource.data.perfil in ['admin','secretaria','lider','voluntario','pastor']
        && request.resource.data.ativo is bool;
      allow delete: if false;
    }

    // O bloco antigo da planilha permanece acessível só para admin/pastor.
    // As telas novas usam as coleções estruturadas abaixo.
    match /appData/primary {
      allow read: if pastor();
      allow write: if admin();
    }
    match /appData/primary/{nested=**} {
      allow read: if pastor();
      allow write: if admin();
    }

    match /turmas/{turmaId} {
      allow read: if staffRead() || (voluntario() && resource.data.status == 'ativa');
      allow create: if staffWrite()
        && validTurma()
        && request.resource.data.status in ['planejada','ativa']
        && request.resource.data.revision == 1
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if staffWrite()
        && resource.data.status != 'encerrada'
        && validTurma()
        && request.resource.data.numero == resource.data.numero
        && request.resource.data.revision == (('revision' in resource.data) ? resource.data.revision + 1 : 1)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'dataBatismo','local','status','capacidade','updatedAt','revision','updatedBy'
        ])
        && ((request.resource.data.status != 'encerrada'
            && (!exists(orderStatePath(turmaId)) || get(orderStatePath(turmaId)).data.closing != true))
          || (request.resource.data.status == 'encerrada'
            && existsAfter(orderStatePath(turmaId))
            && getAfter(orderStatePath(turmaId)).data.frozen == true
            && getAfter(orderStatePath(turmaId)).data.closing == false));
      allow delete: if false;
    }

    match /ordemTurma/{turmaId} {
      allow read: if orderCanRead(turmaId);
      allow create: if validOrderMeta(turmaId)
        && request.resource.data.revision == 1
        && ((orderCanEdit(turmaId)
            && request.resource.data.frozen == false
            && (!('closing' in request.resource.data) || request.resource.data.closing == false))
          || ((staffWrite() || leaderOwnsTurma(turmaId))
            && exists(classPath(turmaId))
            && get(classPath(turmaId)).data.status != 'encerrada'
            && request.resource.data.frozen == true
            && request.resource.data.closing == true)
          || ((staffWrite() || leaderOwnsTurma(turmaId))
            && request.resource.data.frozen == true
            && request.resource.data.closing == false
            && existsAfter(classPath(turmaId))
            && getAfter(classPath(turmaId)).data.status == 'encerrada'));
      allow update: if (staffWrite() || leaderOwnsTurma(turmaId))
        && validOrderMeta(turmaId)
        && request.resource.data.revision == (('revision' in resource.data) ? resource.data.revision + 1 : 1)
        && (
          (exists(classPath(turmaId))
            && get(classPath(turmaId)).data.status != 'encerrada'
            && resource.data.frozen != true
            && request.resource.data.frozen == false
            && (!('closing' in request.resource.data) || request.resource.data.closing == false))
          || (exists(classPath(turmaId))
            && get(classPath(turmaId)).data.status != 'encerrada'
            && resource.data.frozen != true
            && request.resource.data.frozen == true
            && request.resource.data.closing == true)
          || (resource.data.frozen == true
            && resource.data.closing == true
            && existsAfter(classPath(turmaId))
            && getAfter(classPath(turmaId)).data.status == 'encerrada'
            && request.resource.data.frozen == true
            && request.resource.data.closing == false)
        );
      allow delete: if false;
    }

    match /edicaoOrdem/{editorId} {
      allow read: if orderCanRead(resource.data.turmaId);
      allow create, update: if activeUser()
        && (staffWrite() || leaderOwnsTurma(request.resource.data.turmaId))
        && orderCanEdit(request.resource.data.turmaId)
        && request.resource.data.keys().hasOnly(['turmaId','uid','nome','posicaoId','editing','touchedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 120
        && request.resource.data.posicaoId is string
        && request.resource.data.editing is bool
        && request.resource.data.touchedAt is string;
      allow delete: if false;
    }

    match /batismos/{batismoId} {
      allow read: if staffRead();
      // Criados atomicamente na transação que muda a turma para encerrada.
      allow create: if staffWrite()
        && validBaptismRecord()
        && exists(classPath(request.resource.data.turmaId))
        && get(classPath(request.resource.data.turmaId)).data.status != 'encerrada'
        && existsAfter(classPath(request.resource.data.turmaId))
        && getAfter(classPath(request.resource.data.turmaId)).data.status == 'encerrada';
      allow update, delete: if false;
    }

    match /pessoas/{pessoaId} {
      // Voluntários não consultam Pessoas. Líderes recebem só sua turma no app.
      allow read: if staffRead() || leaderOwnsTurma(resource.data.turmaId);
      allow create: if validPersonRoot()
        && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid)
        && (!('revision' in request.resource.data) || request.resource.data.revision == 1)
        && (staffWrite() || leaderOwnsTurma(request.resource.data.turmaId))
        && personClassOpen(request.resource.data.turmaId);
      allow update: if validPersonRoot()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.revision is int
        && request.resource.data.revision == (('revision' in resource.data) ? resource.data.revision + 1 : 1)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'turmaId','nomeExibicao','nomeBusca','telefone','telefoneValido','telefoneRevisar',
          'responsavelInformado','idade','faixaEtaria','menor','jornada','aulas','aulao',
          'camiseta','pendencia','ordemNumero','pastor','batizado','batizadoEm',
          'revision','updatedAt','updatedBy'
        ])
        && (staffWrite() || (leaderOwnsTurma(resource.data.turmaId) && leaderOwnsTurma(request.resource.data.turmaId)))
        && (personClassOpen(resource.data.turmaId) || archivePersonDuringClose(resource.data.turmaId));
      allow delete: if false;

      match /privado/{tipo} {
        // Telefones e responsáveis ficam em subdocumento; origem não é editável pela tela.
        allow read: if tipo == 'contato'
          ? (staffRead() || leaderOwnsTurma(get(/databases/$(database)/documents/pessoas/$(pessoaId)).data.turmaId))
          : pastor();
        allow create, update: if tipo == 'contato'
          ? ((staffWrite() || leaderOwnsTurma(get(/databases/$(database)/documents/pessoas/$(pessoaId)).data.turmaId)) && validContact())
          : tipo == 'perfil'
            ? pastor() && validPrivateProfile()
            : tipo == 'origem' && pastor() && validPrivateOrigin();
        allow delete: if false;
      }
    }

    match /ordem/{posicaoId} {
      allow read: if orderCanRead(resource.data.turmaId);
      allow create: if orderCanEdit(request.resource.data.turmaId)
        && validOrderRoot()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.revision == 1
        && (!('pessoaId' in request.resource.data) || request.resource.data.pessoaId == null
          || (exists(/databases/$(database)/documents/pessoas/$(request.resource.data.pessoaId))
            && get(/databases/$(database)/documents/pessoas/$(request.resource.data.pessoaId)).data.turmaId == request.resource.data.turmaId));
      allow update: if orderCanEdit(resource.data.turmaId)
        && validOrderRoot()
        && request.resource.data.turmaId == resource.data.turmaId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.revision == (('revision' in resource.data) ? resource.data.revision + 1 : 1)
        && (!('pessoaId' in request.resource.data) || request.resource.data.pessoaId == null
          || request.resource.data.pessoaId == resource.data.pessoaId
          || (exists(/databases/$(database)/documents/pessoas/$(request.resource.data.pessoaId))
            && get(/databases/$(database)/documents/pessoas/$(request.resource.data.pessoaId)).data.turmaId == request.resource.data.turmaId));
      allow delete: if false;
      match /privado/origem {
        allow read: if pastor();
        allow create, update: if pastor();
        allow delete: if false;
      }
    }

    match /marcacoesBatismo/{marcacaoId} {
      allow read: if staffRead()
        || (voluntario()
          && resource.data.turmaId == '36'
          && get(/databases/$(database)/documents/turmas/turma_36).data.status == 'ativa');
      allow create, update: if activeUser()
        && (admin() || secretaria() || lider() || voluntario())
        && validMark()
        && request.resource.data.turmaId == '36'
        && get(/databases/$(database)/documents/turmas/turma_36).data.status == 'ativa'
        && (!exists(orderStatePath('turma_36')) || get(orderStatePath('turma_36')).data.frozen != true);
      allow delete: if admin();
    }

    match /regrasInterpretacao/{id} {
      allow read, create, update: if admin();
      allow delete: if false;
    }
    match /gruposDuplicados/{id} {
      allow read, create, update: if admin();
      allow delete: if false;
    }

    match /pendencias/{pendenciaId} {
      allow read: if workflowCanRead(resource.data.turmaId);
      allow create: if workflowCanEdit(request.resource.data.turmaId)
        && validPending()
        && request.resource.data.revision == 1
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.status in ['aberta','em_contato']
        && workflowClassOpen(request.resource.data.turmaId)
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if workflowCanEdit(resource.data.turmaId)
        && validPending()
        && request.resource.data.turmaId == resource.data.turmaId
        && request.resource.data.pessoaId == resource.data.pessoaId
        && request.resource.data.automatico == resource.data.automatico
        && ((!('autoKey' in request.resource.data) && !('autoKey' in resource.data)) || (('autoKey' in request.resource.data) && ('autoKey' in resource.data) && request.resource.data.autoKey == resource.data.autoKey))
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.revision == (('revision' in resource.data) ? resource.data.revision + 1 : 1)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'tipo','responsavel','prazo','status','notas','autoClosed','arquivadaRevisao',
          'resolvidaEm','updatedAt','updatedBy','revision'
        ])
        && ((get(classPath(resource.data.turmaId)).data.status != 'encerrada'
              && (!exists(orderStatePath(resource.data.turmaId)) || get(orderStatePath(resource.data.turmaId)).data.closing != true))
          || (get(classPath(resource.data.turmaId)).data.status == 'encerrada'
              && request.resource.data.status == 'arquivada'
              && request.resource.data.arquivadaRevisao == true
              && resource.data.status in ['aberta','em_contato']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status','arquivadaRevisao','updatedAt','updatedBy','revision'
              ])));
      allow delete: if false;
    }

    match /auloes/{aulaoId} {
      allow read: if workflowCanRead(resource.data.turmaId);
      allow create: if workflowCanEdit(request.resource.data.turmaId)
        && validAulao()
        && request.resource.data.revision == 1
        && request.resource.data.inscritosCount == 0
        && request.resource.data.lastRegistrationPessoaId == null
        && request.resource.data.createdBy == request.auth.uid
        && workflowClassOpen(request.resource.data.turmaId);
      allow update: if workflowCanEdit(resource.data.turmaId)
        && validAulao()
        && request.resource.data.turmaId == resource.data.turmaId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'data','hora','local','vagas','reporAulas','inscritosCount',
          'lastRegistrationPessoaId','status','revision','updatedAt','updatedBy'
        ])
        && workflowClassOpen(resource.data.turmaId)
        && (request.resource.data.inscritosCount == resource.data.inscritosCount
          ? request.resource.data.lastRegistrationPessoaId == resource.data.lastRegistrationPessoaId
          : request.resource.data.inscritosCount == resource.data.inscritosCount + 1
            && request.resource.data.inscritosCount <= request.resource.data.vagas
            && request.resource.data.lastRegistrationPessoaId is string
            && existsAfter(registrationPath(aulaoId,request.resource.data.lastRegistrationPessoaId))
            && getAfter(registrationPath(aulaoId,request.resource.data.lastRegistrationPessoaId)).data.status == 'inscrito'
            && getAfter(registrationPath(aulaoId,request.resource.data.lastRegistrationPessoaId)).data.inscritoPorUid == request.auth.uid);
      allow delete: if false;

      match /inscricoes/{pessoaId} {
        allow read: if workflowCanRead(get(aulaoPath(aulaoId)).data.turmaId);
        allow create: if workflowCanEdit(request.resource.data.turmaId)
          && validRegistration()
          && request.resource.data.pessoaId == pessoaId
          && request.resource.data.status == 'inscrito'
          && request.resource.data.inscritoPorUid == request.auth.uid
          && exists(aulaoPath(aulaoId))
          && get(aulaoPath(aulaoId)).data.turmaId == request.resource.data.turmaId
          && get(aulaoPath(aulaoId)).data.status == 'agendado'
          && exists(pendingPersonPath(pessoaId))
          && get(pendingPersonPath(pessoaId)).data.turmaId == request.resource.data.turmaId
          && workflowClassOpen(request.resource.data.turmaId)
          && get(aulaoPath(aulaoId)).data.inscritosCount < get(aulaoPath(aulaoId)).data.vagas
          && getAfter(aulaoPath(aulaoId)).data.inscritosCount == get(aulaoPath(aulaoId)).data.inscritosCount + 1
          && getAfter(aulaoPath(aulaoId)).data.lastRegistrationPessoaId == pessoaId;
        allow update: if workflowCanEdit(resource.data.turmaId)
          && validRegistration()
          && request.resource.data.turmaId == resource.data.turmaId
          && request.resource.data.pessoaId == pessoaId
          && request.resource.data.inscritoEm == resource.data.inscritoEm
          && request.resource.data.inscritoPorUid == resource.data.inscritoPorUid
          && request.resource.data.inscritoPorNome == resource.data.inscritoPorNome
          && request.resource.data.status == 'presente'
          && resource.data.status == 'inscrito'
          && request.resource.data.presentePorUid == request.auth.uid
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','presenteEm','presentePorUid','presentePorNome','revision','updatedAt','updatedBy'
          ])
          && exists(aulaoPath(aulaoId))
          && get(aulaoPath(aulaoId)).data.turmaId == resource.data.turmaId
          && exists(pendingPersonPath(pessoaId))
          && get(pendingPersonPath(pessoaId)).data.turmaId == resource.data.turmaId
          && existsAfter(pendingPersonPath(pessoaId))
          && getAfter(pendingPersonPath(pessoaId)).data.updatedBy == request.auth.uid
          && getAfter(pendingPersonPath(pessoaId)).data.revision == ((('revision' in get(pendingPersonPath(pessoaId)).data) ? get(pendingPersonPath(pessoaId)).data.revision : 0) + 1)
          && aulasCompletas(getAfter(pendingPersonPath(pessoaId)).data.aulas,get(aulaoPath(aulaoId)).data.reporAulas)
          && workflowClassOpen(resource.data.turmaId);
        allow delete: if false;
      }
    }

    match /pessoas/{pessoaId}/camisetaPagamentos/{paymentId} {
      allow read: if staffRead() || leaderOwnsTurma(get(pendingPersonPath(pessoaId)).data.turmaId);
      allow create: if workflowCanEdit(request.resource.data.turmaId)
        && validPayment()
        && request.resource.data.pessoaId == pessoaId
        && exists(pendingPersonPath(pessoaId))
        && get(pendingPersonPath(pessoaId)).data.turmaId == request.resource.data.turmaId
        && exists(classPath(request.resource.data.turmaId))
        && get(classPath(request.resource.data.turmaId)).data.status != 'encerrada'
        && (!('camiseta' in get(pendingPersonPath(pessoaId)).data) || get(pendingPersonPath(pessoaId)).data.camiseta.pago != true)
        && existsAfter(pendingPersonPath(pessoaId))
        && getAfter(pendingPersonPath(pessoaId)).data.updatedBy == request.auth.uid
        && getAfter(pendingPersonPath(pessoaId)).data.revision == get(pendingPersonPath(pessoaId)).data.revision + 1
        && getAfter(pendingPersonPath(pessoaId)).data.camiseta.opcao == 'quer'
        && getAfter(pendingPersonPath(pessoaId)).data.camiseta.pago == true
        && getAfter(pendingPersonPath(pessoaId)).data.camiseta.valor == request.resource.data.valor
        && getAfter(pendingPersonPath(pessoaId)).data.camiseta.data == request.resource.data.data;
      allow update, delete: if false;
    }

    match /configuracoes/ferramentas {
      allow read: if staffRead();
      allow create: if (admin() || secretaria()) && validWorkConfig() && request.resource.data.revision == 1;
      allow update: if (admin() || secretaria())
        && validWorkConfig()
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'valorCamiseta','tamanhosCamiseta','tiposPendencia','mensagemPendencia',
          'mensagemReposicao','mensagemCamiseta','revision','updatedAt','updatedBy'
        ]);
      allow delete: if false;
    }

    // Auditoria só recebe documentos novos. A leitura do histórico é reservada.
    match /auditoria/{id} {
      allow read: if pastor();
      allow create: if activeUser() && (staffWrite() || lider() || pastor()) && validAudit();
      allow update, delete: if false;
    }

    // Sem regra explícita: o acesso permanece negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}